{
  "name": "@pushary/mastra",
  "version": "0.4.0",
  "description": "Phone approvals for Mastra agents. Your agent asks, your user taps Approve or Deny.",
  "author": "Pushary <business@pushary.com>",
  "homepage": "https://pushary.com/human-in-the-loop-mastra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pushary/pushary-mastra.git"
  },
  "bugs": {
    "url": "https://github.com/Pushary/pushary-mastra/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck",
    "test:restart": "npm run build && node examples/durable-agent.mjs",
    "test:live-http": "npm run build && node examples/verify-live-agent.mjs"
  },
  "dependencies": {
    "@pushary/server": "^2.1.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.59.0 <2.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "1.59.0",
    "@mastra/libsql": "1.20.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pushary",
    "mastra",
    "createtool",
    "suspend-resume",
    "human-in-the-loop",
    "hitl",
    "agent",
    "approval",
    "workflow",
    "llm",
    "tool-approval"
  ]
}
